NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://arthix:arthix-local-only@localhost:5432/arthix
AUTH_SECRET=replace-with-a-long-local-secret

KEYCLOAK_ISSUER=http://localhost:8080/realms/arthix
OIDC_CLIENT_ID=arthix-web
OIDC_CLIENT_SECRET=replace-with-the-keycloak-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

S3_BUCKET=arthix-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=arthix-minio
S3_SECRET_ACCESS_KEY=arthix-minio-local-only
S3_ENDPOINT=http://localhost:9000
