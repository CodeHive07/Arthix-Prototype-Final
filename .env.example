NODE_ENV=development
APP_URL=http://localhost:3000

# Demo mode: skips the production sign-in gate so hosted prototypes can be shown without a live
# identity provider. Only enable for demonstrations; never with real user data.
DEMO_MODE=

# Required for production persistence and signed sessions
DATABASE_URL=
AUTH_SECRET=

# Applicant sign-in via Keycloak OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/arthix
# OIDC_DISCOVERY_URL is optional when KEYCLOAK_ISSUER is set
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Required for private document uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers such as MinIO or an approved private object store
S3_ENDPOINT=

# Compliance Assistant LLM (OpenAI-compatible endpoint).
# Google Gemini (OpenAI-compatible endpoint, same key works):
#   OPENAI_API_KEY=your_gemini_api_key
#   OPENAI_MODEL=gemini-2.5-flash
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Groq free tier example:
#   OPENAI_API_KEY=gsk_your_key
#   OPENAI_MODEL=llama-3.3-70b-versatile
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# Local Ollama example (no API key required):
#   OPENAI_MODEL=llama3.1
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional server-side integrations
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=
