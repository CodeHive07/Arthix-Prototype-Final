NODE_ENV=development
APP_URL=http://localhost:3000

# Required for production persistence and signed sessions
DATABASE_URL=
AUTH_SECRET=

# Applicant sign-in via Keycloak OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/arthix
# OIDC_DISCOVERY_URL is optional when KEYCLOAK_ISSUER is set
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Required for private document uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers such as MinIO or an approved private object store
S3_ENDPOINT=

# Optional server-side integrations
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
